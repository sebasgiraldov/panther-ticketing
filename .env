# =============================================================================
# LOCAL DEVELOPMENT — Panther Ticketing
# Values are dummies for DynamoDB Local + ElasticMQ (no real AWS account needed)
# In production: inject via AWS Secrets Manager / SSM Parameter Store
# NEVER commit real credentials
# =============================================================================

# --- App ---
SERVER_PORT=8080
LOG_LEVEL=INFO
SHUTDOWN_TIMEOUT=30s

# --- AWS (fake credentials for local emulators) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy

# --- DynamoDB Local (amazon/dynamodb-local container on port 8000) ---
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_EVENTS=panther-events
DYNAMODB_TABLE_TICKET_TYPES=panther-ticket-types
DYNAMODB_TABLE_TICKETS=panther-tickets
DYNAMODB_TABLE_RESERVATIONS=panther-reservations
DYNAMODB_TABLE_ORDERS=panther-orders
DYNAMODB_TABLE_INVENTORY=panther-inventory
DYNAMODB_TABLE_AUDIT=panther-audit

# --- SQS via ElasticMQ (SQS-compatible, port 9324) ---
SQS_ENDPOINT=http://localhost:9324
SQS_QUEUE_URL=http://localhost:9324/000000000000/panther-orders

# --- Scheduler ---
RESERVATION_SCHEDULER_DELAY_MS=60000
